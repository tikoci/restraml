{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tikoci.github.io/restraml/7.26beta4/routeros-app-yaml-schema.json",
  "title": "RouterOS /app YAML",
  "description": "Schema for MikroTik RouterOS /app YAML",
  "type": "object",
  "required": [
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name for the /app"
    },
    "descr": {
      "type": "string",
      "description": "Description of the /app"
    },
    "page": {
      "type": "string",
      "format": "uri",
      "description": "URL of the project page, shown as the /app's `project-page` property"
    },
    "category": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "productivity",
            "storage",
            "networking",
            "development",
            "communication",
            "file-management",
            "search",
            "video",
            "media",
            "media-management",
            "home-automation",
            "monitoring",
            "database",
            "automation",
            "ai",
            "messaging",
            "radio",
            "security",
            "business"
          ]
        },
        {
          "type": "string"
        }
      ],
      "description": "Classification group shown in the /app list. Any string is accepted (the manual's examples include `network`, `system`, `utilities`); the listed values are the categories MikroTik's built-in apps use"
    },
    "icon": {
      "type": "string",
      "format": "uri",
      "description": "URL of an icon image displayed on the WebFig landing page (when `/app/settings show-in-webfig=yes`, the default)"
    },
    "default-credentials": {
      "type": [
        "string",
        "null"
      ],
      "description": "Login credentials in `username:password` format. Informative only; may be left blank. Can contain runtime placeholders such as `[secret:name]`"
    },
    "url-path": {
      "type": "string",
      "description": "Path appended to the /app URL, for example `/login` or `/web`"
    },
    "credentials": {
      "type": "string",
      "description": "Credential hint displayed in the app UI (alternative to default-credentials)"
    },
    "option": {
      "type": "boolean",
      "description": "Whether this /app is optional"
    },
    "auto-update": {
      "type": "boolean",
      "description": "When `true`, the /app is updated automatically when a new container image is available"
    },
    "supported-archs": {
      "type": "array",
      "description": "CPU architectures supported by the /app. Devices not matching the specified architecture do not display the /app (RouterOS 7.25+)",
      "items": {
        "type": "string",
        "enum": [
          "arm",
          "arm64",
          "arm_v5",
          "x86"
        ]
      },
      "uniqueItems": true
    },
    "compatible-boards": {
      "type": "array",
      "description": "Board names supported by the /app, for example `RDS2216`; the `*` wildcard is accepted. Devices not matching the specified board name do not display the /app",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secrets": {
      "type": "object",
      "description": "Secret declarations, referenced with `[secret:name]` placeholders and by service `secrets`. RouterOS generates the values when the /app runs",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "description": "Container service definitions. At least one service is required",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string",
              "description": "Container image to use.  Can prepend the container registry, or the `registry-url` in `/container/config` will be assumed."
            },
            "container_name": {
              "type": "string",
              "description": "Container name shown in the `/container` menu. Also used in file paths."
            },
            "hostname": {
              "type": "string",
              "description": "Container hostname"
            },
            "entrypoint": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              ],
              "description": "Executable used as the container entry point (overrides the image default)"
            },
            "command": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              ],
              "description": "Startup command executed inside the container (overrides the image default)"
            },
            "ports": {
              "type": "array",
              "description": "Port mappings",
              "items": {
                "$comment": "Port mappings can be strings (two formats) or objects (long syntax with name/target/published/app_protocol).",
                "oneOf": [
                  {
                    "type": "string",
                    "$comment": "Two port formats supported, exactly one protocol style per entry: (1) old OCI-style [ip:]host:container[/tcp|/udp][:label] and (2) new RouterOS 7.23+ style [ip:]host:container[:label][:tcp|:udp]. Mixing styles (e.g. host:container/tcp:label:tcp) is rejected.",
                    "anyOf": [
                      {
                        "$comment": "Old OCI-style: [ip:]host:container[/tcp|/udp][:label]",
                        "pattern": "^(\\d+\\.\\d+\\.\\d+\\.\\d+:|\\[[a-zA-Z0-9]+\\]:)?(\\d+|\\[[a-zA-Z0-9]+\\]):(\\d+|\\[[a-zA-Z0-9]+\\])(\\/tcp|\\/udp)?(:[^:\\n\\r]+)?$"
                      },
                      {
                        "$comment": "New RouterOS 7.23+ style: [ip:]host:container[:label][:tcp|:udp]. Label may not contain / or : to stay distinct from old style.",
                        "pattern": "^(\\d+\\.\\d+\\.\\d+\\.\\d+:|\\[[a-zA-Z0-9]+\\]:)?(\\d+|\\[[a-zA-Z0-9]+\\]):(\\d+|\\[[a-zA-Z0-9]+\\])(:[^:\\/\\n\\r]+)?(:(tcp|udp))?$"
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "$comment": "Long syntax port mapping with named fields",
                    "required": [
                      "target",
                      "published"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Port mapping label"
                      },
                      "target": {
                        "type": [
                          "integer",
                          "string"
                        ],
                        "pattern": "^[0-9]+$",
                        "description": "Container port"
                      },
                      "published": {
                        "type": [
                          "integer",
                          "string"
                        ],
                        "pattern": "^[0-9]+$",
                        "description": "Host port"
                      },
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "tcp",
                          "udp"
                        ],
                        "description": "Protocol (tcp or udp)"
                      },
                      "app_protocol": {
                        "type": "string",
                        "description": "Application protocol hint"
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "environment": {
              "oneOf": [
                {
                  "type": "object",
                  "patternProperties": {
                    "^[A-Z_][A-Z0-9_]*$": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Environment variables"
            },
            "volumes": {
              "type": "array",
              "description": "Volume mappings",
              "items": {
                "type": "string"
              }
            },
            "configs": {
              "type": "array",
              "description": "Config file mappings",
              "items": {
                "type": "object",
                "required": [
                  "source",
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "mode": {
                    "type": [
                      "integer",
                      "string"
                    ],
                    "description": "File permissions in octal"
                  }
                }
              }
            },
            "restart": {
              "type": "string",
              "enum": [
                "no",
                "always",
                "on-failure",
                "unless-stopped"
              ],
              "description": "Restart policy of the container"
            },
            "depends_on": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "object"
                }
              ],
              "description": "Names of services that must start before this service"
            },
            "devices": {
              "type": "array",
              "description": "Hardware devices passed through to the container, for example `/dev/ttyACM0:/dev/ttyACM0`",
              "items": {
                "type": "string"
              }
            },
            "user": {
              "type": "string",
              "description": "Linux user or UID the container runs as"
            },
            "security_opt": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security options"
            },
            "shm_size": {
              "type": "string",
              "description": "Shared memory size, for example `512mb` or `1gb`"
            },
            "stop_grace_period": {
              "type": [
                "string",
                "integer"
              ],
              "description": "Timeout for graceful shutdown, for example `30s` or `0` (default 30 seconds)"
            },
            "ulimits": {
              "type": "object",
              "description": "Resource limits (e.g. nofile soft/hard)",
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "soft",
                        "hard"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "soft": {
                          "type": [
                            "integer",
                            "string"
                          ],
                          "pattern": "^[0-9]+$"
                        },
                        "hard": {
                          "type": [
                            "integer",
                            "string"
                          ],
                          "pattern": "^[0-9]+$"
                        }
                      }
                    },
                    {
                      "type": [
                        "integer",
                        "string"
                      ],
                      "pattern": "^[0-9]+$"
                    }
                  ]
                }
              }
            },
            "build": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "context": {
                      "type": "string"
                    },
                    "dockerfile": {
                      "type": "string"
                    },
                    "args": {
                      "type": "object"
                    }
                  }
                },
                {
                  "type": "string"
                }
              ],
              "description": "Build configuration for a locally built image"
            },
            "healthcheck": {
              "type": "object",
              "description": "Health check run when the container starts; `test` runs inside the container and passes on exit code 0",
              "additionalProperties": false,
              "properties": {
                "test": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "interval": {
                  "type": "string"
                },
                "timeout": {
                  "type": "string"
                },
                "retries": {
                  "type": [
                    "integer",
                    "string"
                  ],
                  "pattern": "^[0-9]+$"
                },
                "start_period": {
                  "type": "string"
                }
              }
            },
            "stdin_open": {
              "type": "boolean",
              "description": "Keep stdin open even if not attached"
            },
            "expose": {
              "type": "array",
              "description": "Ports exposed to other containers without publishing them on the router",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "secrets": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "string"
                }
              ],
              "description": "Secret names available to this service, mounted as files at `/run/secrets/<name>`"
            },
            "secret": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "string"
                }
              ],
              "description": "Singular secret alias accepted by RouterOS built-in app YAML"
            },
            "attach": {
              "type": "boolean",
              "description": "Whether to attach to the container's stdio"
            }
          }
        }
      },
      "minProperties": 1
    },
    "volumes": {
      "type": "object",
      "description": "Named volumes definition",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "networks": {
      "type": "object",
      "description": "Network declarations. Define `default` as an external network (e.g. `lan`) to place the /app directly on it instead of behind NAT",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "external": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "configs": {
      "type": "object",
      "description": "Config files definition.  Used along with a service's `configs`, which controls placement of the contents.",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string",
              "description": "Inline config file content"
            }
          }
        }
      }
    }
  }
}
