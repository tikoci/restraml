{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun-types"]
  },
  "include": ["*.ts", "fixtures/**/*.ts", "scripts/**/*.ts"],
  // archived research scripts, not part of CI type gate
  "exclude": ["scripts/native-api-investigation"]
}
